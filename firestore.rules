rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Le champ `type` (patient / professional / admin) ne peut jamais être choisi ou changé
      // depuis le navigateur : sinon n'importe qui pourrait se déclarer admin.
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && (!('type' in request.resource.data) || request.resource.data.type == 'patient');
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['type']);

      // Contrôle d'accès vie intime
      match /acces/{document} {
        allow read, write: if isOwner(userId);
      }

      // Journal intime
      match /journal/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // Chat Dr Lô
      match /chat_dr_lo/{conversationId} {
        allow read, write: if isOwner(userId);
      }

      // Discussions de l'accueil (copie écrite par la fonction drlo-threads) : lecture par la personne
      match /accueil_threads/{convId} {
        allow read: if isOwner(userId);
      }

      // Prompts journal intelligents
      match /journal_prompts/{promptId} {
        allow read, write: if isOwner(userId);
      }

      // Cache des conseils Dr Lô par évaluation
      match /conseils_cache/{scaleId} {
        allow read, write: if isOwner(userId);
      }

      // État onboarding (welcome + tooltips vus)
      match /onboarding/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── PATIENTS ─────────────────────────────────────────────────────────────
    match /patients/{patientId} {
      allow read: if isOwner(patientId);
      // Le portefeuille d'étincelles n'est jamais créé par le navigateur (sinon : solde choisi à la création)
      allow create: if isOwner(patientId) && !('korisWallet' in request.resource.data);
      allow update: if isOwner(patientId)
        && (!('korisWallet' in request.resource.data) ||
            request.resource.data.korisWallet == resource.data.korisWallet);
    }

    // ─── COMPANION APP (/app) — check-ins quotidiens ──────────────────────────
    // Le profil companion (situation, cycle, streak) vit dans le champ
    // `companion` du document patients/{patientId} ci-dessus (même règle).
    match /patients/{patientId}/checkins/{checkinId} {
      allow read, write: if isOwner(patientId);
    }

    // Humeur notée depuis Dr Lô (« Noter mon humeur · 30 s ») — strictement privée
    match /patients/{patientId}/moods/{day} {
      allow read, write: if isOwner(patientId);
    }

    match /patients/{patientId}/korisHistory/{entryId} {
      allow read: if isOwner(patientId);
    }

    // ─── ANCIENNE DIRECTION (téléconsultation, réservations, messagerie avec les pros) ──
    // Plus aucune page ne s'en sert : fermé au navigateur. Les données restent lisibles par les admins
    // (règle générale plus bas) et les fonctions serveur (Admin SDK) ne sont pas concernées.
    match /professionals/{id} { allow read, write: if false; }
    match /professionals_public/{id} { allow read, write: if false; }
    match /{path=**}/medicalRecords/{recordId} { allow read, write: if false; }
    match /bookings/{id} { allow read, write: if false; }
    match /temp_redirects/{id} { allow read, write: if false; }
    match /roomLinks/{id} { allow read, write: if false; }
    match /conversations/{conversationId} {
      allow read, write: if false;
      match /messages/{messageId} { allow read, write: if false; }
    }

    // ─── CONTENT (FAQ, Terms, etc.) ───────────────────────────────────────────
    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── NOTIFICATIONS (cloche) ──────────────────────────────────────────────
    // Créées par le serveur seulement ; la personne lit les siennes et les marque lues.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow create, delete: if false;
    }

    // ─── ANCIENNE DIRECTION (suite) : fermé au navigateur ─────────────────────
    match /calendar_events/{id} { allow read, write: if false; }
    match /supportTickets/{id} { allow read, write: if false; }
    match /supportMessages/{id} { allow read, write: if false; }
    match /revenue_transactions/{id} { allow read, write: if false; }
    match /withdrawals/{id} { allow read, write: if false; }
    match /withdrawalRequests/{id} { allow read, write: if false; }
    match /professional_patients/{id} { allow read, write: if false; }
    // E-mails : plus envoyés depuis le navigateur (lecture de tous les e-mails par n'importe quel compte avant)
    match /mail/{mailId} { allow read, write: if false; }
    match /group_therapy_sessions/{sessionId} {
      allow read, write: if false;
      match /{rest=**} { allow read, write: if false; }
    }

    // ─── LE CAS DU SOIR : votes, résultats, achats ; écrits par le serveur (cas-du-soir.js) seulement ──
    match /casDuSoirVotes/{id} { allow read, write: if false; }
    match /casDuSoirResultats/{id} { allow read, write: if false; }
    match /casDuSoirAcces/{id} { allow read, write: if false; }

    // ─── ADMIN CATCHALL ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Health-e 2.0 : Évaluations ──────────────────────────────────────
    match /assessmentSessions/{sessionId} {
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Profils des autres : plus de lecture depuis le navigateur (résultats psy et intimes, analyses).
      // La compatibilité passe par la fonction serveur compatibility-partner, qui ne renvoie
      // que ce que le code partagé permet de voir. Les admins gardent la lecture (tableaux de bord).
      allow read: if isAdmin();

      // Sous-collection historique des résultats
      match /scaleResultHistory/{entryId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Sous-collection des défis créés par l'utilisateur
      match /mesDefis/{slug} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Sous-collection des petits mots reçus par le créateur
      match /defiMessages/{msgId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['masque', 'signale'])
          && request.resource.data.masque is bool
          && request.resource.data.signale is bool;
        allow create, delete: if false;
      }
    }

    // Rôles particuliers (ex. { drlo: true } pour le vrai Dr Lô). Posés à la main dans la console
    // Firebase ; la personne peut lire son propre rôle, personne ne peut l'écrire depuis le navigateur.
    match /staff/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // « Écrire au vrai Dr Lô » : uniquement via la fonction serveur drlo-question (jamais depuis le navigateur)
    match /drloQuestions/{qid} { allow read, write: if false; }
    match /drloQueue/{uid} { allow read, write: if false; }

    match /compatibilityRequests/{requestId} {
      // Seule la personne qui a lancé la comparaison lit / crée / met à jour (le résultat parle de deux personnes)
      allow read: if request.auth != null && resource.data.initiatorUserId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.initiatorUserId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.initiatorUserId == request.auth.uid);
      allow delete: if false;
    }

    match /compatibilityHistory/{entryId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ─── CONFIG (feature flags) ─────────────────────────────────────────────
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── DÉFI ───────────────────────────────────────────────────────────────
    match /defis/{slug} {
      allow get: if true;
      allow list, write: if false;
    }

    match /defis_private/{slug} {
      allow read, write: if false;
    }

    match /defi_reponses/{id} {
      allow read, write: if false;
    }
  }
}
